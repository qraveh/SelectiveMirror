<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?include Variables.wxi ?>

  <Package Name="$(var.ProductName)"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perUser"
           InstallerVersion="500">

    <SummaryInformation Description="$(var.Description)" />

    <!-- Upgrade handling: remove older versions during install -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed."
                  Schedule="afterInstallInitialize" />

    <!-- UI -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="Resources\license.rtf" />

    <!-- Media -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Directory structure: per-user install to %LOCALAPPDATA%\SelectiveMirror -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolder)" />
    </StandardDirectory>

    <!-- Main component group -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- smirror.exe (KeyPath = HKCU registry, per ICE38 per-user requirement) -->
      <Component Id="SmirrorExe" Guid="A1B2C3D4-E5F6-4A5B-8C9D-0E1F2A3B4C5D">
        <File Id="smirror.exe" Source="..\bin\smirror.exe" />
        <RegistryValue Root="HKCU" Key="Software\$(var.ProductName)" Name="ExePath" Type="string" Value="[INSTALLFOLDER]smirror.exe" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>

      <!-- Documentation files -->
      <Component Id="ReadmeFile" Guid="B2C3D4E5-F6A7-4B5C-9D0E-1F2A3B4C5D6E">
        <File Id="README.md" Source="..\README.md" />
        <RegistryValue Root="HKCU" Key="Software\$(var.ProductName)" Name="Readme" Type="string" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="LicenseFile" Guid="C3D4E5F6-A7B8-4C5D-0E1F-2A3B4C5D6E7F">
        <File Id="LICENSE" Source="..\LICENSE" />
        <RegistryValue Root="HKCU" Key="Software\$(var.ProductName)" Name="License" Type="string" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="CreditsFile" Guid="D4E5F6A7-B8C9-4D5E-1F2A-3B4C5D6E7F8A">
        <File Id="CREDITS.md" Source="..\CREDITS.md" />
        <RegistryValue Root="HKCU" Key="Software\$(var.ProductName)" Name="Credits" Type="string" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyFile" Guid="E5F6A7B8-C9D0-4E5F-2A3B-4C5D6E7F8A9B">
        <File Id="THIRD_PARTY_LICENSES.txt" Source="..\THIRD-PARTY-LICENSES.txt" />
        <RegistryValue Root="HKCU" Key="Software\$(var.ProductName)" Name="ThirdParty" Type="string" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="ConfigExample" Guid="F6A7B8C9-D0E1-4F5A-3B4C-5D6E7F8A9B0C">
        <File Id="config.example.yaml" Source="..\config.example.yaml" />
        <RegistryValue Root="HKCU" Key="Software\$(var.ProductName)" Name="ConfigExample" Type="string" Value="1" KeyPath="yes" />
      </Component>

      <!-- rclone installer script -->
      <Component Id="RcloneInstaller" Guid="2B3C4D5E-6F7A-4B8C-9D0E-1F2A3B4C5D6F">
        <File Id="install_rclone.ps1" Source="install-rclone.ps1" />
        <RegistryValue Root="HKCU" Key="Software\$(var.ProductName)" Name="RcloneInstaller" Type="string" Value="1" KeyPath="yes" />
      </Component>

      <!-- PATH environment variable (user-level, no admin required) -->
      <Component Id="PathEnv" Guid="A7B8C9D0-E1F2-4A5B-4C5D-6E7F8A9B0C1D">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]"
                     Permanent="no" Part="last" Action="set" System="no" />
        <RegistryValue Root="HKCU" Key="Software\$(var.ProductName)" Name="PathSet" Type="string" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Custom action: install rclone after files are placed -->
    <CustomAction Id="InstallRclone"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]install-rclone.ps1&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- Custom actions: service install + start (only when elevated) -->
    <CustomAction Id="ServiceInstall"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]smirror.exe&quot; service install"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="ServiceStart"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]smirror.exe&quot; service start"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Custom actions: service stop + uninstall during MSI removal (only when elevated) -->
    <CustomAction Id="ServiceStop"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]smirror.exe&quot; service stop"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="ServiceUninstall"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]smirror.exe&quot; service uninstall"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Install: rclone always, service only if elevated -->
      <Custom Action="InstallRclone" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="ServiceInstall" After="InstallRclone" Condition="NOT Installed AND Privileged" />
      <Custom Action="ServiceStart" After="ServiceInstall" Condition="NOT Installed AND Privileged" />

      <!-- Uninstall: service teardown only if elevated -->
      <Custom Action="ServiceStop" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND Privileged" />
      <Custom Action="ServiceUninstall" After="ServiceStop" Condition="REMOVE~=&quot;ALL&quot; AND Privileged" />
    </InstallExecuteSequence>

    <!-- Features -->
    <Feature Id="ProductFeature" Title="SelectiveMirror" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

  </Package>
</Wix>
