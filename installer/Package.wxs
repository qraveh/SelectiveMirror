<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?include Variables.wxi ?>

  <Package Name="$(var.ProductName)"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="$(var.Description)" />

    <!-- Upgrade handling: remove older versions during install -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed."
                  Schedule="afterInstallInitialize" />

    <!-- UI -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="Resources\license.rtf" />

    <!-- Media -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Directory structure: per-machine install to %ProgramFiles%\SelectiveMirror
         (admin-only write access, SEC-C2 fix). Program Files on 64-bit Windows
         is %ProgramFiles64Folder% so the 64-bit binary lands in the expected
         location, not the 32-bit WOW64 tree. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolder)" />
    </StandardDirectory>

    <!-- Main component group. KeyPath registry entries moved from HKCU to HKLM
         because perMachine components must use per-machine registry keys
         (WiX ICE57 / MSI SDK guidance). -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- smirror.exe -->
      <Component Id="SmirrorExe" Guid="A1B2C3D4-E5F6-4A5B-8C9D-0E1F2A3B4C5D">
        <File Id="smirror.exe" Source="..\bin\smirror.exe" />
        <RegistryValue Root="HKLM" Key="Software\$(var.ProductName)" Name="ExePath" Type="string" Value="[INSTALLFOLDER]smirror.exe" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>

      <!-- Documentation files -->
      <Component Id="ReadmeFile" Guid="B2C3D4E5-F6A7-4B5C-9D0E-1F2A3B4C5D6E">
        <File Id="README.md" Source="..\README.md" />
        <RegistryValue Root="HKLM" Key="Software\$(var.ProductName)" Name="Readme" Type="string" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="LicenseFile" Guid="C3D4E5F6-A7B8-4C5D-0E1F-2A3B4C5D6E7F">
        <File Id="LICENSE" Source="..\LICENSE" />
        <RegistryValue Root="HKLM" Key="Software\$(var.ProductName)" Name="License" Type="string" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="CreditsFile" Guid="D4E5F6A7-B8C9-4D5E-1F2A-3B4C5D6E7F8A">
        <File Id="CREDITS.md" Source="..\CREDITS.md" />
        <RegistryValue Root="HKLM" Key="Software\$(var.ProductName)" Name="Credits" Type="string" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyFile" Guid="E5F6A7B8-C9D0-4E5F-2A3B-4C5D6E7F8A9B">
        <File Id="THIRD_PARTY_LICENSES.txt" Source="..\THIRD-PARTY-LICENSES.txt" />
        <RegistryValue Root="HKLM" Key="Software\$(var.ProductName)" Name="ThirdParty" Type="string" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="ConfigExample" Guid="F6A7B8C9-D0E1-4F5A-3B4C-5D6E7F8A9B0C">
        <File Id="config.example.yaml" Source="..\config.example.yaml" />
        <RegistryValue Root="HKLM" Key="Software\$(var.ProductName)" Name="ConfigExample" Type="string" Value="1" KeyPath="yes" />
      </Component>

      <!-- rclone installer script -->
      <Component Id="RcloneInstaller" Guid="2B3C4D5E-6F7A-4B8C-9D0E-1F2A3B4C5D6F">
        <File Id="install_rclone.ps1" Source="install-rclone.ps1" />
        <RegistryValue Root="HKLM" Key="Software\$(var.ProductName)" Name="RcloneInstaller" Type="string" Value="1" KeyPath="yes" />
      </Component>

      <!-- PATH environment variable (system-level, perMachine install). -->
      <Component Id="PathEnv" Guid="A7B8C9D0-E1F2-4A5B-4C5D-6E7F8A9B0C1D">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]"
                     Permanent="no" Part="last" Action="set" System="yes" />
        <RegistryValue Root="HKLM" Key="Software\$(var.ProductName)" Name="PathSet" Type="string" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Custom action: install rclone after files are placed.
         Runs deferred, impersonated, as the installing user so rclone lands
         in their winget/chocolatey/scoop scope rather than SYSTEM's. -->
    <CustomAction Id="InstallRclone"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]install-rclone.ps1&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- Service install / start / stop / uninstall custom actions REMOVED.
         Background registration is now a user-invoked post-install step:
           * Default: smirror task install       (per-user, no admin)
           * Advanced: smirror service install   (24/7, admin required,
                       requires admin-owned config per SEC-C5)
         The MSI no longer silently turns every install into a LocalSystem
         service (SEC-C2 fix). Users choose their background mode. -->

    <InstallExecuteSequence>
      <!-- Install: rclone install only; no service registration. -->
      <Custom Action="InstallRclone" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <!-- Features -->
    <Feature Id="ProductFeature" Title="SelectiveMirror" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

  </Package>
</Wix>
