<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?include Variables.wxi ?>
  <?include TelemetryConsent.wxi ?>

  <Package Name="$(var.ProductName)"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="$(var.Description)" />

    <!-- Upgrade handling: remove older versions during install -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed."
                  Schedule="afterInstallInitialize" />

    <!-- Product icon (Add/Remove Programs / "Apps & features" / "Installed
         apps"). MSI requires a multi-size .ico — generated from
         installer/Resources/sm_icon.png at 1024×1024 via PIL into the
         standard Windows icon size set (16, 20, 24, 32, 40, 48, 64, 96,
         128, 256). The Id MUST end in .ico for the Windows Installer to
         recognize the Icon table entry as an icon resource.

         Source-of-truth note: regenerate sm_icon.ico from sm_icon.png via
         the one-liner in `installer/Resources/README` (or just rerun the
         PIL snippet) any time the source PNG changes. The ICO is
         committed so the build doesn't need PIL at MSI-build time. -->
    <Icon Id="ProductIcon.ico" SourceFile="Resources\sm_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />

    <!-- UI -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="Resources\license.rtf" />

    <!-- Branded installer artwork. Replaces the WiX-default CD-ROM-on-red
         bitmaps with the SelectiveMirror folders+arrow logo on white.
         Both BMPs are 24-bit, generated from Resources\sm_icon.png by the
         PIL snippet in Resources\README.md; regenerate any time the
         source PNG changes.

           WixUIDialogBmp (493x312): Welcome and Exit dialogs left graphic.
           WixUIBannerBmp (493x58):  inner-dialog top banner (License /
                                     InstallDir / Tier / Progress / etc.). -->
    <WixVariable Id="WixUIDialogBmp" Value="Resources\WelcomeDlgBmp.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="Resources\BannerBmp.bmp" />
    <!-- PR-S2 (panel review pre-release 2026-04-28): pull in the
         telemetry-tier selection dialog defined in
         installer/TelemetryConsent.wxi. The UI element there contains
         the Dialog + RadioButtonGroup + Publish overrides that splice
         TelemetryTierDlg between LicenseAgreementDlg and InstallDirDlg
         in the WixUI_InstallDir chain. -->
    <UIRef Id="WixUI_TelemetryTier" />

    <!-- Media -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Directory structure: per-machine install to %ProgramFiles%\SelectiveMirror
         (admin-only write access, SEC-C2 fix). ProgramFiles64Folder is the
         64-bit Program Files on x64 Windows. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolder)">
        <!-- Tutorial subtree (SM-221). The MSI ships the hands-on
             local-mirror tutorial alongside the binary so MSI-only users
             (no source checkout) can run it directly out of
             %ProgramFiles%\SelectiveMirror\examples\local-mirror-tutorial\.
             The tutorial's Step 1 xcopy pulls fixtures FROM here INTO the
             user's workspace; nothing here is modified in place, so the
             admin-only write tier on %ProgramFiles% is not a problem. -->
        <Directory Id="ExamplesDir" Name="examples">
          <Directory Id="TutorialDir" Name="local-mirror-tutorial">
            <Directory Id="TutorialSourceTemplate" Name="source-template">
              <Directory Id="TutorialMirrorThisDir" Name="mirror_this_dir" />
              <Directory Id="TutorialDontMirrorThisDir" Name="dont_mirror_this_dir" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Main component group.

         Design note: Each file-component uses its File as the KeyPath and
         Guid="*" so WiX auto-generates a stable unique GUID from the install
         path. Previous versions used hand-crafted sequential GUIDs
         (A1B2C3D4..., B2C3D4E5..., ...) which collided with unrelated
         products' component entries and caused uninstall to preserve some
         files. Auto-generated GUIDs are the WiX-recommended pattern for
         per-machine installs and eliminate that failure mode. -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- smirror.exe — the owning component also carries RemoveFolder so
           the install dir goes away at uninstall time. -->
      <Component Id="SmirrorExe" Bitness="always64" Guid="*">
        <File Id="smirror.exe" Source="..\bin\smirror.exe" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>

      <!-- Documentation and support files. File element is the implicit
           KeyPath (one file per component, WiX promotes it automatically). -->
      <Component Id="ReadmeFile" Bitness="always64" Guid="*">
        <File Id="README.md" Source="..\README.md" KeyPath="yes" />
      </Component>
      <Component Id="LicenseFile" Bitness="always64" Guid="*">
        <File Id="LICENSE" Source="..\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="CreditsFile" Bitness="always64" Guid="*">
        <File Id="CREDITS.md" Source="..\CREDITS.md" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyFile" Bitness="always64" Guid="*">
        <File Id="THIRD_PARTY_LICENSES.txt" Source="..\THIRD-PARTY-LICENSES.txt" KeyPath="yes" />
      </Component>
      <Component Id="ConfigExample" Bitness="always64" Guid="*">
        <File Id="config.example.yaml" Source="..\config.example.yaml" KeyPath="yes" />
      </Component>
      <Component Id="RcloneInstaller" Bitness="always64" Guid="*">
        <File Id="install_rclone.ps1" Source="install-rclone.ps1" KeyPath="yes" />
      </Component>

      <!-- PATH environment variable (system-level, perMachine install).
           No file, so the component needs a registry KeyPath — this is the
           one case where ICE38-style registry key is still appropriate. -->
      <Component Id="PathEnv" Bitness="always64" Guid="*">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]"
                     Permanent="no" Part="last" Action="set" System="yes" />
        <RegistryValue Root="HKLM" Key="Software\$(var.ProductName)" Name="PathSet" Type="string" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Tutorial subtree (SM-221). Twelve fixture files + the tutorial
         README, installed alongside the binary so MSI-only users can run
         the tutorial without a source checkout. RemoveFolder elements on
         the README component clean up the subdirectories at uninstall —
         the auto-generated GUIDs handle file uninstall on their own. -->
    <ComponentGroup Id="TutorialComponents">

      <Component Id="TutorialReadme" Directory="TutorialDir" Bitness="always64" Guid="*">
        <File Id="tutorial_README.md" Source="..\examples\local-mirror-tutorial\README.md" KeyPath="yes" />
        <!-- Sweep nested directories at uninstall. The files themselves
             go away via their own components; these cleanups remove the
             now-empty directories so %ProgramFiles%\SelectiveMirror is
             clean after uninstall. -->
        <RemoveFolder Id="RemoveTutorialMirrorThisDir" Directory="TutorialMirrorThisDir" On="uninstall" />
        <RemoveFolder Id="RemoveTutorialDontMirrorThisDir" Directory="TutorialDontMirrorThisDir" On="uninstall" />
        <RemoveFolder Id="RemoveTutorialSourceTemplate" Directory="TutorialSourceTemplate" On="uninstall" />
        <RemoveFolder Id="RemoveTutorialDir" Directory="TutorialDir" On="uninstall" />
        <RemoveFolder Id="RemoveExamplesDir" Directory="ExamplesDir" On="uninstall" />
      </Component>

      <!-- Fixture files in source-template/ -->
      <Component Id="TutorialFixtureSyncignore" Directory="TutorialSourceTemplate" Bitness="always64" Guid="*">
        <File Id="tutorial_syncignore" Name=".syncignore" Source="..\examples\local-mirror-tutorial\source-template\.syncignore" KeyPath="yes" />
      </Component>
      <Component Id="TutorialFixtureHidden" Directory="TutorialSourceTemplate" Bitness="always64" Guid="*">
        <File Id="tutorial_dont_mirror_hidden.txt" Name=".dont_mirror_hidden.txt" Source="..\examples\local-mirror-tutorial\source-template\.dont_mirror_hidden.txt" KeyPath="yes" />
      </Component>
      <Component Id="TutorialFixtureLog" Directory="TutorialSourceTemplate" Bitness="always64" Guid="*">
        <File Id="tutorial_dont_mirror_me.log" Source="..\examples\local-mirror-tutorial\source-template\dont_mirror_me.log" KeyPath="yes" />
      </Component>
      <Component Id="TutorialFixtureTmp" Directory="TutorialSourceTemplate" Bitness="always64" Guid="*">
        <File Id="tutorial_dont_mirror_me.tmp" Source="..\examples\local-mirror-tutorial\source-template\dont_mirror_me.tmp" KeyPath="yes" />
      </Component>
      <Component Id="TutorialFixtureFileA" Directory="TutorialSourceTemplate" Bitness="always64" Guid="*">
        <File Id="tutorial_file_a.txt" Source="..\examples\local-mirror-tutorial\source-template\file_a.txt" KeyPath="yes" />
      </Component>
      <Component Id="TutorialFixtureFileB" Directory="TutorialSourceTemplate" Bitness="always64" Guid="*">
        <File Id="tutorial_file_b.txt" Source="..\examples\local-mirror-tutorial\source-template\file_b.txt" KeyPath="yes" />
      </Component>
      <Component Id="TutorialFixtureMirrorMe1" Directory="TutorialSourceTemplate" Bitness="always64" Guid="*">
        <File Id="tutorial_mirror_me_1.txt" Source="..\examples\local-mirror-tutorial\source-template\mirror_me_1.txt" KeyPath="yes" />
      </Component>
      <Component Id="TutorialFixtureMirrorMe2" Directory="TutorialSourceTemplate" Bitness="always64" Guid="*">
        <File Id="tutorial_mirror_me_2.txt" Source="..\examples\local-mirror-tutorial\source-template\mirror_me_2.txt" KeyPath="yes" />
      </Component>

      <!-- Files in source-template/mirror_this_dir/ -->
      <Component Id="TutorialFixtureNested1" Directory="TutorialMirrorThisDir" Bitness="always64" Guid="*">
        <File Id="tutorial_nested_1.txt" Source="..\examples\local-mirror-tutorial\source-template\mirror_this_dir\nested_1.txt" KeyPath="yes" />
      </Component>
      <Component Id="TutorialFixtureNested2" Directory="TutorialMirrorThisDir" Bitness="always64" Guid="*">
        <File Id="tutorial_nested_2.txt" Source="..\examples\local-mirror-tutorial\source-template\mirror_this_dir\nested_2.txt" KeyPath="yes" />
      </Component>

      <!-- Files in source-template/dont_mirror_this_dir/ -->
      <Component Id="TutorialFixtureStuff" Directory="TutorialDontMirrorThisDir" Bitness="always64" Guid="*">
        <File Id="tutorial_stuff.txt" Source="..\examples\local-mirror-tutorial\source-template\dont_mirror_this_dir\stuff.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Custom action: install rclone after files are placed.
         Runs deferred, impersonated, as the installing user so rclone lands
         in their winget/chocolatey/scoop scope rather than SYSTEM's. -->
    <CustomAction Id="InstallRclone"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]install-rclone.ps1&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- Service install / start / stop / uninstall custom actions are
         intentionally absent. Background registration is a user-invoked
         post-install step:
           * Default: smirror task install       (per-user, no admin)
           * Advanced: smirror service install   (24/7, admin required,
                       requires admin-owned config per SEC-C5)
         The MSI no longer silently turns every install into a LocalSystem
         service (SEC-C2 fix). Users choose their background mode. -->

    <InstallExecuteSequence>
      <Custom Action="InstallRclone" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <!-- Features -->
    <Feature Id="ProductFeature" Title="SelectiveMirror" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <!-- Telemetry consent registry component. Always installed; the
           value is the property INSTALL_TELEMETRY_OPT_IN (default 0 =
           opt-out). Sets HKLM\Software\SelectiveMirror\TelemetryOptIn,
           which smirror reads on first run to seed state DB metadata.
           See installer/TelemetryConsent.wxi for property definition. -->
      <ComponentGroupRef Id="TelemetryConsentComponents" />
      <!-- Hands-on tutorial files (SM-221). Ships with the binary so
           MSI-only users (no source checkout) can run the tutorial
           directly. ~12 small files, <20KB total. -->
      <ComponentGroupRef Id="TutorialComponents" />
    </Feature>

  </Package>
</Wix>
