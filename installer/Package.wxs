<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?include Variables.wxi ?>

  <Package Name="$(var.ProductName)"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="$(var.Description)" />

    <!-- Upgrade handling: remove older versions during install -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed."
                  Schedule="afterInstallInitialize" />

    <!-- UI -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="Resources\license.rtf" />

    <!-- Media -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Directory structure -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolder)">
        <Directory Id="DocsFolder" Name="docs" />
      </Directory>
    </StandardDirectory>

    <!-- Main component group -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- smirror.exe -->
      <Component Id="SmirrorExe" Guid="A1B2C3D4-E5F6-4A5B-8C9D-0E1F2A3B4C5D">
        <File Id="smirror.exe" Source="..\bin\smirror.exe" KeyPath="yes" />
      </Component>

      <!-- Documentation files -->
      <Component Id="ReadmeFile" Guid="B2C3D4E5-F6A7-4B5C-9D0E-1F2A3B4C5D6E">
        <File Id="README.txt" Source="..\README.txt" />
      </Component>
      <Component Id="LicenseFile" Guid="C3D4E5F6-A7B8-4C5D-0E1F-2A3B4C5D6E7F">
        <File Id="LICENSE" Source="..\LICENSE" />
      </Component>
      <Component Id="CreditsFile" Guid="D4E5F6A7-B8C9-4D5E-1F2A-3B4C5D6E7F8A">
        <File Id="CREDITS.md" Source="..\CREDITS.md" />
      </Component>
      <Component Id="ThirdPartyFile" Guid="E5F6A7B8-C9D0-4E5F-2A3B-4C5D6E7F8A9B">
        <File Id="THIRD_PARTY_LICENSES.txt" Source="..\THIRD-PARTY-LICENSES.txt" />
      </Component>
      <Component Id="ConfigExample" Guid="F6A7B8C9-D0E1-4F5A-3B4C-5D6E7F8A9B0C">
        <File Id="config.example.yaml" Source="..\config.example.yaml" />
      </Component>

      <!-- Bundled rclone.exe -->
      <Component Id="RcloneExe" Guid="1A2B3C4D-5E6F-4A7B-8C9D-0E1F2A3B4C5E">
        <File Id="rclone.exe" Source="..\bin\rclone.exe" KeyPath="yes" />
      </Component>

      <!-- PATH environment variable -->
      <Component Id="PathEnv" Guid="A7B8C9D0-E1F2-4A5B-4C5D-6E7F8A9B0C1D">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]"
                     Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
    </ComponentGroup>

    <!-- PDF manuals in docs subfolder -->
    <ComponentGroup Id="DocsComponents" Directory="DocsFolder">
      <Component Id="InstallManual" Guid="B8C9D0E1-F2A3-4B5C-5D6E-7F8A9B0C1D2E">
        <File Id="InstallManual.pdf" Source="..\docs\Installation Manual.pdf" />
      </Component>
      <Component Id="UserManual" Guid="C9D0E1F2-A3B4-4C5D-6E7F-8A9B0C1D2E3F">
        <File Id="UserManual.pdf" Source="..\docs\User Manual.pdf" />
      </Component>
      <Component Id="DevManual" Guid="D0E1F2A3-B4C5-4D5E-7F8A-9B0C1D2E3F4A">
        <File Id="DevManual.pdf" Source="..\docs\Developer Manual.pdf" />
      </Component>
    </ComponentGroup>

    <!-- Features -->
    <Feature Id="ProductFeature" Title="SelectiveMirror" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <!-- PDF manuals — Level="2" means not installed by default (PDFs built separately) -->
      <Feature Id="DocsFeature" Title="PDF Documentation" Level="2">
        <ComponentGroupRef Id="DocsComponents" />
      </Feature>
    </Feature>

  </Package>
</Wix>
