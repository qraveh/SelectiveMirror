# Binary
*.exe

# IDE / AI tools
.idea/
.vscode/
.claude/*
# Carve-out: project-shared Claude Code subagents live under
# .claude/agents/ (PR-PM3, panel review pre-release 2026-04-28). Local
# state (settings.local.json, worktrees/, scheduled_tasks.lock, etc.)
# remains ignored.
!.claude/agents/
!.claude/agents/**
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Go
vendor/

# State (runtime)
*.db
*.db-wal
*.db-shm

# Logs
*.log

# User config
config.yaml
!config.example.yaml

# Test run artifacts (ephemeral, generated by test/run_tests.ps1)
_testrun_*/

# Runtime state files
heartbeat.txt
status.json
smirror.lock

# Build artifacts
bin/
installer/bin/
installer/obj/
docs/*.pdf

# Test coverage profiles (go test -coverprofile=*.out)
*.out
coverage*.txt

# Bug reports
smirror-bug-report-*.txt

# Cloudflare Worker (worker/ dir)
worker/node_modules/
worker/.wrangler/

# Codex / experimental validation work (per-machine, not part of the project)
Codex/

# Python bytecode caches (generated by maintenance scripts)
__pycache__/
*.pyc

# Personal narrative drafts (commit only when promoted to docs)
docs/story10.md
