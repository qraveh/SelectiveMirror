# Binary
*.exe

# IDE / AI tools
.idea/
.vscode/
.claude/*
# Carve-out: project-shared Claude Code subagents live under
# .claude/agents/. Local state (settings.local.json, worktrees/,
# scheduled_tasks.lock, etc.) remains ignored.
!.claude/agents/
!.claude/agents/**
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Go
vendor/

# State (runtime)
*.db
*.db-wal
*.db-shm

# Logs
*.log

# User config
config.yaml
!config.example.yaml

# Test run artifacts (ephemeral, generated by test/run_tests.ps1)
_testrun_*/

# Runtime state files
heartbeat.txt
status.json
smirror.lock

# Build artifacts
bin/
installer/bin/
installer/obj/
docs/*.pdf

# Test coverage profiles (go test -coverprofile=*.out / *.txt /
# bare 'coverage'). The bare-name pattern is the default
# `go test -coverprofile=coverage` produces.
*.out
coverage*.txt
/coverage

# Bug reports
smirror-bug-report-*.txt

# Cloudflare Worker (worker/ dir)
worker/node_modules/
worker/.wrangler/

# Codex / experimental validation work (per-machine, not part of the project)
Codex/

# Python bytecode caches (generated by maintenance scripts)
__pycache__/
*.pyc

# Personal narrative drafts (commit only when promoted to docs)
docs/story10.md

# Maintainer-side notes (preserved on disk, not redistributed)
docs/internal/system-validation-memos/
docs/audit-validation-report-*.md
docs/iso-audit-required-actions-*.md
docs/iso-audit-response-*.md
docs/iso-compliance-review-*.md
system-validation/telemetry_validation.md

# Telemetry digest / operator-report snapshots
# (regenerated from scripts/telemetry-report.py + scripts/telemetry-debug.py)
system-validation/telemetry-digest-*.md
system-validation/telemetry-operator-report-*.md
system-validation/telemetry-published-weekly-digest-*.md

# Local scratch directory
junk/

# Release-time go-test JSON output (redirected to $RUNNER_TEMP in CI;
# this entry is a fallback for direct repo-root writes)
system-validation-results.json
