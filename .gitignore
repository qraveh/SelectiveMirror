# Binary
*.exe

# IDE / AI tools
.idea/
.vscode/
.claude/*
# Carve-out: project-shared Claude Code subagents live under
# .claude/agents/ (PR-PM3, panel review pre-release 2026-04-28). Local
# state (settings.local.json, worktrees/, scheduled_tasks.lock, etc.)
# remains ignored.
!.claude/agents/
!.claude/agents/**
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Go
vendor/

# State (runtime)
*.db
*.db-wal
*.db-shm

# Logs
*.log

# User config
config.yaml
!config.example.yaml

# Test run artifacts (ephemeral, generated by test/run_tests.ps1)
_testrun_*/

# Runtime state files
heartbeat.txt
status.json
smirror.lock

# Build artifacts
bin/
installer/bin/
installer/obj/
docs/*.pdf

# Test coverage profiles (go test -coverprofile=*.out / *.txt /
# bare 'coverage'). The bare-name pattern is the default
# `go test -coverprofile=coverage` produces.
*.out
coverage*.txt
/coverage

# Bug reports
smirror-bug-report-*.txt

# Cloudflare Worker (worker/ dir)
worker/node_modules/
worker/.wrangler/

# Codex / experimental validation work (per-machine, not part of the project)
Codex/

# Python bytecode caches (generated by maintenance scripts)
__pycache__/
*.pyc

# Personal narrative drafts (commit only when promoted to docs)
docs/story10.md

# Telemetry digest / operator-report snapshots — regeneratable from
# scripts/telemetry-report.py + scripts/telemetry-debug.py. Round-N
# point-in-time outputs land in system-validation/ during validation
# rounds; the scripts themselves and the validation memos that
# reference them are tracked, but the markdown snapshots are not.
system-validation/telemetry-digest-*.md
system-validation/telemetry-operator-report-*.md
system-validation/telemetry-published-weekly-digest-*.md

# Junk drawer for non-load-bearing validation artifacts. Round-N
# conversational deep-dive memos, one-shot adversarial Python row
# injectors, mass-emulation harness scripts. The decisions they
# drove land in source code (sanitize.go regexes, CLAIMS-MAP rows,
# BugTracker SM-NNN closure notes) — the workings themselves are
# scaffolding. Tag-day worktree-clean (runbook §4) is satisfied by
# moving them here rather than committing them. Per-session decision;
# files inside junk/ are NOT under document control.
junk/
